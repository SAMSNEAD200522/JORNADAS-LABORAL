{
  "productName": "Jornadas Laborales",
  "version": "1.0.0",
  "identifier": "co.empresa.jornadas-laborales",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "Control de Jornadas Laborales",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:*; style-src 'self' 'unsafe-inline' http://localhost:*; font-src 'self' http://localhost:*; img-src 'self' data: http://localhost:*; script-src 'self' 'unsafe-inline' http://localhost:*; connect-src 'self' http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    }
  },
  "plugins": {}
}
