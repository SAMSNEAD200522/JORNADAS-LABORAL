# Base de datos
DATABASE_URL="file:./jornadas.db"

# JWT
JWT_SECRET="cambia_esto_por_un_secreto_seguro"

# JWT expiry time
JWT_EXPIRES_IN="8h"

# Aplicación
APP_PORT=3000
APP_PREFIX="/api/v1"

# CORS (comma-separated origins)
CORS_ORIGINS="http://localhost:3001,http://localhost:3000"

# Zona horaria del sistema
TZ="America/Bogota"
